<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
                     tools:ignore="ScopedStorage"/>
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
                     tools:ignore="ProtectedPermissions"/>

    <application
        android:name=".HostApp"
        android:label="Calculadora"
        android:icon="@drawable/ic_calc"
        android:roundIcon="@drawable/ic_calc"
        android:theme="@style/Theme.FFKit">

        <meta-data android:name="xposedmodule"     android:value="true"/>
        <meta-data android:name="xposeddescription"
                   android:value="ffkit — injeta libffkit no FF dentro do VirtualXposed"/>
        <meta-data android:name="xposedminversion" android:value="53"/>
        <meta-data android:name="xposedscope"
                   android:resource="@array/xposed_scope"/>

        <activity android:name=".MainActivity"
                  android:exported="true"
                  android:excludeFromRecents="true"
                  android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity-alias android:name=".Calc"
            android:targetActivity=".MainActivity"
            android:enabled="true"  android:exported="true"
            android:icon="@drawable/ic_calc"
            android:roundIcon="@drawable/ic_calc"
            android:label="Calculadora"/>
        <activity-alias android:name=".Weather"
            android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_weather"
            android:roundIcon="@drawable/ic_weather"
            android:label="Clima"/>
        <activity-alias android:name=".Notes"
            android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_notes"
            android:roundIcon="@drawable/ic_notes"
            android:label="Bloco de Notas"/>
        <activity-alias android:name=".Flashlight"
            android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_flash"
            android:roundIcon="@drawable/ic_flash"
            android:label="Lanterna"/>
        <activity-alias android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_files"
            android:roundIcon="@drawable/ic_files"
            android:label="Arquivos"/>

        <service android:name=".PanicService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                       android:resource="@xml/accessibility"/>
        </service>

        <service android:name=".CvService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false"/>

        <activity android:name=".ProjectionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"/>
    </application>
</manifest>
